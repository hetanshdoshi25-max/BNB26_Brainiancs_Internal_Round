generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICIPANT
  ORGANIZER
}

enum DropStatus {
  DRAFT
  OPEN
  CLOSED
}

enum AllocationPolicy {
  FIRST_COME
  RANDOM_DRAW
}

enum EntryStatus {
  ENTERED
  RESERVED
  WAITLISTED
  CONFIRMED
  EXPIRED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(PARTICIPANT)
  signupHumanScore Int?
  createdAt    DateTime  @default(now())
  sessions     Session[]
  entries      Entry[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Drop {
  id                 String     @id @default(cuid())
  title              String
  description        String     @default("")
  venue              String     @default("Online")
  eventDate          DateTime
  capacity           Int
  allocationPolicy   AllocationPolicy @default(RANDOM_DRAW)
  limitsEnabled      Boolean          @default(true)
  status             DropStatus @default(DRAFT)
  opensAt            DateTime?
  closesAt           DateTime?
  reservationMinutes Int        @default(10)
  drawCompletedAt    DateTime?
  drawSeedHash       String?
  drawSeed           String?
  drawCommittedAt    DateTime?
  seatMap            Boolean    @default(false)
  createdAt          DateTime   @default(now())
  entries            Entry[]
  seats              Seat[]

  @@index([status, closesAt])
}

model Entry {
  id                   String      @id @default(cuid())
  dropId               String
  userId               String
  arrivalSequence     Int         @unique @default(autoincrement())
  status               EntryStatus @default(ENTERED)
  rank                 Int?
  enteredAt            DateTime    @default(now())
  reservationExpiresAt DateTime?
  confirmedAt          DateTime?
  ticketCode           String?     @unique
  humanScore           Int?
  drop                 Drop        @relation(fields: [dropId], references: [id], onDelete: Cascade)
  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  seat                 Seat?

  @@unique([dropId, userId])
  @@unique([dropId, rank])
  @@index([dropId, status, rank])
  @@index([dropId, status, arrivalSequence])
  @@index([status, reservationExpiresAt])
}

// A specific seat for drops with seat selection. A seat is taken while entryId is set:
// held while that entry is RESERVED, booked once it is CONFIRMED. entryId is unique,
// so an entry holds at most one seat, and (dropId, label) is unique, so a seat exists once.
model Seat {
  id      String  @id @default(cuid())
  dropId  String
  label   String
  row     String
  number  Int
  entryId String? @unique
  drop    Drop    @relation(fields: [dropId], references: [id], onDelete: Cascade)
  entry   Entry?  @relation(fields: [entryId], references: [id], onDelete: SetNull)

  @@unique([dropId, label])
  @@index([dropId])
}
