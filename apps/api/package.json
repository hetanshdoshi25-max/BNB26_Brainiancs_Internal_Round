{
  "name": "@fair-drop/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "db:generate": "node scripts/prisma.cjs generate --schema prisma/schema.prisma",
    "db:migrate": "node scripts/prisma.cjs migrate dev --schema prisma/schema.prisma --name init",
    "db:seed": "tsx prisma/seed.ts",
    "load:accounts": "tsx scripts/seed-load-users.ts",
    "db:deploy": "node scripts/prisma.cjs migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "prisma": "^6.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
